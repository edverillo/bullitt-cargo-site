---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Bullitt cargo bike — measurements, 3D customiser, gallery, and guides.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — Bullitt Cargo Bike</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --black: #0d0d0d;
        --white: #f5f5f5;
        --mid: #888;
        --accent: #e63c2f;
        --font: 'D-DIN', 'DIN', system-ui, sans-serif;
        --mono: 'DIN Condensed', 'D-DIN Condensed', ui-monospace, monospace;
      }
      html { font-size: 16px; color: var(--black); background: var(--white); font-family: var(--font); }
      a { color: inherit; }
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      .site-header {
        border-bottom: 1px solid var(--black);
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 56px;
      }
      .wordmark { font-size: 1.1rem; font-weight: 700; letter-spacing: 0.08em; text-decoration: none; text-transform: uppercase; }
      nav ul { list-style: none; display: flex; gap: 1.5rem; }
      nav a { font-size: 0.85rem; text-decoration: none; opacity: 0.7; text-transform: uppercase; letter-spacing: 0.05em; }
      nav a:hover, nav a[aria-current="page"] { opacity: 1; text-decoration: underline; }

      .hamburger { display: none; background: none; border: none; cursor: pointer; padding: 4px; }
      .hamburger span { display: block; width: 22px; height: 2px; background: var(--black); margin: 4px 0; transition: 0.2s; }

      @media (max-width: 680px) {
        nav { position: fixed; top: 56px; left: 0; right: 0; background: var(--white); border-bottom: 1px solid var(--black); display: none; z-index: 100; }
        nav.open { display: block; }
        nav ul { flex-direction: column; gap: 0; padding: 0.5rem 1.5rem 1rem; }
        nav li { border-bottom: 1px solid #e0e0e0; }
        nav a { display: block; padding: 0.75rem 0; opacity: 1; }
        .hamburger { display: block; }
      }

      main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
      h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.5rem; }
      h2 { font-size: 1.4rem; font-weight: 700; margin: 2rem 0 1rem; }
      p { line-height: 1.65; max-width: 68ch; }
      .subtitle { color: var(--mid); margin-bottom: 2rem; }

      footer { border-top: 1px solid #ddd; padding: 1.5rem; text-align: center; font-size: 0.8rem; color: var(--mid); }
    </style>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.querySelector('.hamburger');
        const nav = document.querySelector('nav');
        if (btn && nav) btn.addEventListener('click', () => nav.classList.toggle('open'));
      });
    </script>
  </head>
  <body>
    <header class="site-header">
      <a href={`${base}/`} class="wordmark" aria-label="Bullitt Cargo Bike home">Bullitt</a>
      <button class="hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav aria-label="Main navigation">
        <ul>
          <li><a href={`${base}/`} aria-current={Astro.url.pathname === `${base}/` || Astro.url.pathname === '/' ? 'page' : undefined}>Home</a></li>
          <li><a href={`${base}/measurements`} aria-current={Astro.url.pathname.startsWith(`${base}/measurements`) ? 'page' : undefined}>Measurements</a></li>
          <li><a href={`${base}/models`} aria-current={Astro.url.pathname.startsWith(`${base}/models`) ? 'page' : undefined}>Models</a></li>
          <li><a href={`${base}/customiser`} aria-current={Astro.url.pathname.startsWith(`${base}/customiser`) ? 'page' : undefined}>3D Customiser</a></li>
          <li><a href={`${base}/gallery`} aria-current={Astro.url.pathname.startsWith(`${base}/gallery`) ? 'page' : undefined}>Gallery</a></li>
          <li><a href={`${base}/guides`} aria-current={Astro.url.pathname.startsWith(`${base}/guides`) ? 'page' : undefined}>Guides</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Bullitt is a trademark of Larry vs Harry. This is an independent fan/reference site. Content licensed CC BY-SA 4.0 where applicable.</p>
    </footer>
  </body>
</html>
