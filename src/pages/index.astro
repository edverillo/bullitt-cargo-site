---
import Base from '../layouts/Base.astro';
---
<Base title="Home">
  <style>
    .hero { padding: 4rem 0 3rem; border-bottom: 1px solid #ddd; margin-bottom: 3rem; }
    .hero h1 span { color: #e63c2f; }
    .cta-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; }
    .btn { display: inline-block; padding: 0.65rem 1.4rem; text-decoration: none; font-size: 0.9rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; border: 2px solid #0d0d0d; transition: 0.15s; }
    .btn:hover { background: #0d0d0d; color: #f5f5f5; }
    .btn.primary { background: #0d0d0d; color: #f5f5f5; }
    .btn.primary:hover { background: #333; border-color: #333; }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.5rem; margin-top: 1rem; }
    .card { border: 1px solid #ddd; padding: 1.5rem; }
    .card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; }
    .card p { font-size: 0.875rem; color: #555; margin: 0; }
    .card a { display: block; margin-top: 1rem; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  </style>

  <section class="hero">
    <h1>The <span>Bullitt</span><br>cargo bike, documented.</h1>
    <p class="subtitle">Open measurements, 3D model, gallery, and maintenance guides — all in one place.</p>
    <div class="cta-row">
      <a href={`${import.meta.env.BASE_URL}customiser`} class="btn primary">Open 3D Customiser</a>
      <a href={`${import.meta.env.BASE_URL}measurements`} class="btn">View Measurements</a>
      <a href={`${import.meta.env.BASE_URL}downloads`} class="btn">Downloads</a>
    </div>
  </section>

  <h2>Explore</h2>
  <div class="cards">
    <div class="card">
      <h3>Measurements</h3>
      <p>50+ confirmed dimensions from official technical drawings. Includes geometry table and CSV download.</p>
      <a href={`${import.meta.env.BASE_URL}measurements`}>View table →</a>
    </div>
    <div class="card">
      <h3>Model Variants</h3>
      <p>Original, Shorty, Classic-E, Black Edition — specs and differences side by side.</p>
      <a href={`${import.meta.env.BASE_URL}models`}>Compare models →</a>
    </div>
    <div class="card">
      <h3>3D Customiser</h3>
      <p>Interactive viewer. Change frame, deck, and accent colours. Share your config via URL.</p>
      <a href={`${import.meta.env.BASE_URL}customiser`}>Customise →</a>
    </div>
    <div class="card">
      <h3>Gallery</h3>
      <p>CC-licensed photos of Bullitt bikes in the wild — with attribution and alt text.</p>
      <a href={`${import.meta.env.BASE_URL}gallery`}>Browse gallery →</a>
    </div>
    <div class="card">
      <h3>Guides</h3>
      <p>Maintenance checklists, upgrade walkthroughs, and cargo attachment safety guides.</p>
      <a href={`${import.meta.env.BASE_URL}guides`}>Read guides →</a>
    </div>
    <div class="card">
      <h3>Downloads</h3>
      <p>Dimensioned drawings in SVG and PDF, measurements CSV, and 3D model files.</p>
      <a href={`${import.meta.env.BASE_URL}downloads`}>Downloads →</a>
    </div>
  </div>
</Base>
