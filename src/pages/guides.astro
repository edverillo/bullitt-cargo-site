---
import Base from '../layouts/Base.astro';
import guides from '../data/guides.json';
---
<Base title="Guides" description="Bullitt cargo bike maintenance, upgrade, and cargo attachment guides.">
  <style>
    .search-row { margin: 1rem 0 1.5rem; }
    #guide-search { width: 100%; max-width: 400px; padding: 0.6rem 0.75rem; border: 1px solid #ccc; font-size: 0.9rem; }
    #guide-search:focus { outline: 2px solid #e63c2f; outline-offset: 0; border-color: #e63c2f; }
    .guide-list { display: flex; flex-direction: column; gap: 0; }
    .guide-item { border-bottom: 1px solid #e8e8e8; padding: 1.25rem 0; display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: start; }
    .guide-item[hidden] { display: none; }
    .guide-item h2 { font-size: 1.05rem; font-weight: 700; margin: 0 0 0.4rem; }
    .guide-item p { font-size: 0.875rem; color: #555; margin: 0; }
    .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.5rem; }
    .tag { font-size: 0.7rem; padding: 2px 7px; border: 1px solid #ccc; border-radius: 2px; color: #666; }
    .read-link { padding: 0.5rem 1rem; border: 2px solid #0d0d0d; text-decoration: none; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; }
    .read-link:hover { background: #0d0d0d; color: #f5f5f5; }
  </style>

  <h1>Guides</h1>
  <p class="subtitle">Maintenance checklists, upgrade walkthroughs, and cargo handling safety guides.</p>

  <div class="search-row">
    <input id="guide-search" type="search" placeholder="Search guides…" aria-label="Search guides" />
  </div>

  <div class="guide-list" id="guide-list">
    {guides.map(g => (
      <article class="guide-item" data-title={g.title.toLowerCase()} data-tags={g.tags.join(' ')}>
        <div>
          <h2>{g.title}</h2>
          <p>{g.description}</p>
          <div class="tags">
            {g.tags.map(t => <span class="tag">{t}</span>)}
          </div>
        </div>
        <a href={`${import.meta.env.BASE_URL}guides/${g.slug}`} class="read-link">Read →</a>
      </article>
    ))}
  </div>

  <script>
    const input = document.getElementById('guide-search');
    input?.addEventListener('input', () => {
      const q = input.value.toLowerCase();
      document.querySelectorAll('.guide-item').forEach(el => {
        const title = el.dataset.title || '';
        const tags = el.dataset.tags || '';
        el.hidden = q.length > 0 && !title.includes(q) && !tags.includes(q);
      });
    });
  </script>
</Base>
